{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/contracts/review-integration/v2/schemas/status-v7.schema.json",
  "title": "Gentle AI Review Integration native Git target status v7",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "contract", "operation", "applicability", "action", "replayability",
    "target_identity", "projection", "repair", "candidates"
  ],
  "properties": {
    "schema": {"const": "gentle-ai.review-integration.status/v7"},
    "contract": {"$ref": "status-v5.schema.json#/properties/contract"}, "operation": {"$ref": "status-v5.schema.json#/properties/operation"},
    "applicability": {"$ref": "status-v5.schema.json#/properties/applicability"}, "authority": {"$ref": "status-v5.schema.json#/properties/authority"},
    "action": {"enum": ["start", "none", "validate", "recover", "maintainer_action", "select_lineage", "repair_authority", "stop", "collect", "execute"]}, "action_disposition": {"$ref": "status-v5.schema.json#/properties/action_disposition"},
    "replayability": {"$ref": "status-v5.schema.json#/properties/replayability"}, "frozen": {"type": "object", "additionalProperties": false, "required": ["tier", "original_changed_lines", "correction_budget"], "properties": {"tier": {"enum": ["low", "medium", "high"]}, "original_changed_lines": {"type": "integer", "minimum": 0}, "correction_budget": {"type": "integer", "minimum": 0, "maximum": 200}, "changed_path_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "target_identity": {"$ref": "status-v5.schema.json#/properties/target_identity"}, "authority_target_identity": {"$ref": "status-v5.schema.json#/properties/authority_target_identity"}, "terminal_receipt": {"type": "object", "description": "#4405: immutable terminal review receipt, present exactly when applicability is acknowledged. This exact frozen target was reviewed, approved, and acknowledged, and its authority burned. It is the durable trace STATUS resolves so an acknowledged approval is never reoffered as a fresh unreviewed target. It never carries review content, source bytes, or the acknowledgement token, and it grants nothing by itself.", "additionalProperties": false, "required": ["schema", "lineage_id", "target_identity", "consumed_revision", "current_snapshot", "burned_at"], "properties": {"schema": {"type": "string"}, "lineage_id": {"type": "string"}, "target_identity": {"type": "string"}, "consumed_revision": {"type": "string"}, "projection": {"type": "string"}, "current_snapshot": {"type": "object", "description": "The frozen snapshot the approval covered: structural identity only (trees, digests, repository-relative paths), never review content or source bytes.", "additionalProperties": false, "required": ["kind", "base_tree", "candidate_tree", "paths_digest", "intended_untracked", "intended_untracked_proof", "paths", "identity"], "properties": {"kind": {"type": "string"}, "projection": {"type": "string"}, "unborn_head": {"type": "boolean"}, "base_tree": {"type": "string"}, "candidate_tree": {"type": "string"}, "paths_digest": {"type": "string"}, "intended_untracked": {"type": "array", "items": {"type": "string"}}, "intended_untracked_proof": {"type": "string"}, "ledger_ids": {"type": "array", "items": {"type": "string"}}, "paths": {"type": "array", "items": {"type": "string"}}, "identity": {"type": "string"}}}, "burned_at": {"type": "string"}}},
    "projection": {"$ref": "status-v5.schema.json#/properties/projection"}, "repair": {"$ref": "status-v5.schema.json#/properties/repair"},
    "candidates": {"$ref": "status-v5.schema.json#/properties/candidates"}, "reconciliation": {"$ref": "status-v5.schema.json#/properties/reconciliation"},
    "eligibility": {"$ref": "status-v5.schema.json#/properties/eligibility"}, "forecast": {"$ref": "status-v5.schema.json#/properties/forecast"},
    "next_transition": {"$ref": "#/$defs/next_transition"}, "validation_request": {"$ref": "status-v5.schema.json#/properties/validation_request"},
    "repository_context": {"$ref": "status-v5.schema.json#/properties/repository_context"}, "disposition": {"$ref": "status-v5.schema.json#/properties/disposition"},
    "eligible_untracked_inventory": {"$ref": "status-v5.schema.json#/$defs/sha256"},
    "escalation": {"$ref": "last-event-closure.schema.json#/properties/escalation"}
  },
  "dependentRequired": {"forecast": ["next_transition"]},
  "$defs": {
    "next_transition": {"oneOf": [
      {"allOf": [
        {"$ref": "status-v5.schema.json#/$defs/next_transition"},
        {"not": {"properties": {"reason_code": {"enum": ["intended_untracked_selection_required", "managed_assets_outdated"]}}, "required": ["reason_code"]}}
      ]},
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "reason_code", "continuation"],
        "properties": {
          "kind": {"const": "stop"},
          "reason_code": {"const": "managed_assets_outdated"},
          "continuation": {"$ref": "failure.schema.json#/$defs/managed_assets_continuation"}
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "reason_code", "collect"],
        "properties": {
          "kind": {"const": "collect"},
          "reason_code": {"const": "intended_untracked_selection_required"},
          "collect": {
            "type": "object", "additionalProperties": false, "required": ["inputs"],
            "properties": {"inputs": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "schema", "capture_operation", "arguments"],
                "properties": {
                  "name": {"const": "intended_untracked_selection"},
                  "schema": {"const": "gentle-ai.review-intended-untracked-selection/v1"},
                  "capture_operation": {"const": "external.select_intended_untracked"},
                  "arguments": {"type": "array", "minItems": 6, "maxItems": 6, "prefixItems": [
                    {"$ref": "status-v6.schema.json#/$defs/contract_argument"}, {"$ref": "status-v6.schema.json#/$defs/next_transition_argument"},
                    {"$ref": "status-v6.schema.json#/$defs/agent_argument"}, {"$ref": "status-v6.schema.json#/$defs/workspace_projection_argument"},
                    {"$ref": "status-v6.schema.json#/$defs/eligible_paths_argument"}, {"$ref": "status-v6.schema.json#/$defs/untracked_inventory_argument"}
                  ], "items": false},
                  "submission": {"$ref": "status-v6.schema.json#/$defs/intended_untracked_submission"}
                }
              }
            }}
          }
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "reason_code", "unachievable_lens_slots"],
        "properties": {
          "kind": {"const": "stop"}, "reason_code": {"const": "unachievable_lens_slot"},
          "unachievable_lens_slots": {"type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["lens", "selected_order", "subject_hash", "reason", "withdraw"],
            "properties": {
              "lens": {"type": "string", "minLength": 1}, "selected_order": {"type": "integer", "minimum": 0},
              "subject_hash": {"$ref": "status-v5.schema.json#/$defs/sha256"}, "reason": {"type": "string", "minLength": 1},
              "detail": {"type": "string"},
              "withdraw": {
                "type": "object", "additionalProperties": false, "required": ["operation", "command", "arguments", "binding"],
                "properties": {
                  "operation": {"const": "review.capture-unachievable"},
                  "command": {"type": "string", "minLength": 1, "pattern": "^gentle-ai review capture-unachievable "},
                  "arguments": {"type": "array", "items": {"$ref": "transition-execution.schema.json#/$defs/executable_transition_argument"}},
                  "binding": {"$ref": "transition-binding.schema.json"}
                }
              }
            }
          }}
        }
      }
    ]}
  },
  "allOf": [
    {"$ref": "status-v5.schema.json#/allOf/0"}, {"$ref": "status-v5.schema.json#/allOf/1"},
    {"$ref": "status-v5.schema.json#/allOf/2"}, {"$ref": "status-v5.schema.json#/allOf/3"},
    {"$ref": "status-v5.schema.json#/allOf/4"},
    {"if": {"properties": {"authority": {"properties": {"version": {"const": "compact-v2"}, "state": {"const": "escalated"}}, "required": ["version", "state"]}}, "required": ["authority"]}, "then": {"required": ["escalation"]}, "else": {"not": {"required": ["escalation"]}}}
  ]
}
